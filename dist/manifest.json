{
  "manifest_version": 3,
  "name": "History Blocker",
  "version": "0.1.0",
  "description": "Keeps chosen websites out of your browser history.",
  "permissions": ["history", "storage", "tabs"],
  "action": {
    "default_title": "History Blocker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
